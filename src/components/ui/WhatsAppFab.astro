---
/**
 * Botón flotante persistente de WhatsApp. Mensaje genérico (sin contexto de producto),
 * literal de _brief/01-contenido-y-estructura.md sección E.
 * Se mantiene dentro de la paleta navy/naranja del sistema (nunca el verde de marca WhatsApp).
 */
import { contacto } from '../../data/publico';
import { buildWhatsAppLink, WHATSAPP_GENERIC_MESSAGE } from './whatsapp';

const href = buildWhatsAppLink(contacto.whatsapp, WHATSAPP_GENERIC_MESSAGE);
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Cotizar por WhatsApp"
  class="fixed bottom-6 right-6 z-50 flex items-center gap-2 h-14 pl-4 pr-5 rounded-full
         bg-navy border border-white/10 shadow-[0_12px_30px_rgba(2,48,99,0.5)]
         hover:bg-navy-light hover:scale-105 active:scale-95
         focus-visible:outline-2 focus-visible:outline-orange focus-visible:outline-offset-2
         transition-all duration-200"
>
  <svg width="26" height="26" viewBox="0 0 24 24" fill="none" aria-hidden="true" class="shrink-0">
    <path
      fill="currentColor"
      class="text-paper"
      d="M12.04 2c-5.5 0-9.96 4.46-9.96 9.96 0 1.76.46 3.45 1.32 4.95L2 22l5.24-1.37a9.94 9.94 0 0 0 4.8 1.22h.01c5.5 0 9.96-4.46 9.96-9.96S17.54 2 12.04 2Zm0 18.2h-.01a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.1.81.83-3.02-.2-.31a8.22 8.22 0 0 1-1.26-4.39c0-4.55 3.7-8.25 8.25-8.25 2.2 0 4.27.86 5.83 2.42a8.2 8.2 0 0 1 2.42 5.84c0 4.55-3.71 8.24-8.27 8.24Zm4.52-6.17c-.25-.12-1.47-.72-1.7-.81-.23-.08-.39-.12-.56.13-.16.24-.64.8-.78.97-.14.16-.29.18-.53.06-.25-.12-1.04-.38-1.98-1.22-.73-.65-1.22-1.45-1.37-1.7-.14-.24-.02-.37.11-.5.11-.11.25-.29.37-.43.12-.15.16-.25.25-.42.08-.16.04-.31-.02-.43-.06-.12-.56-1.35-.77-1.85-.2-.48-.41-.42-.56-.43h-.48c-.16 0-.43.06-.66.31-.22.24-.87.85-.87 2.08s.89 2.41 1.02 2.58c.12.16 1.75 2.67 4.24 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.67-1.18.21-.58.21-1.08.15-1.18-.06-.1-.23-.16-.48-.28Z"
    />
  </svg>
  <span class="hidden sm:inline text-caption uppercase tracking-[0.04em] font-display font-semibold text-paper">
    Cotizar
  </span>
</a>
