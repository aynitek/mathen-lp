---
import '../styles/global.css';
import { contacto } from '../data/publico';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Mathen Perú | Calaminas, Paneles y Coberturas a Medida',
  description = 'Calaminas Aluzinc, paneles sándwich, placa colaborante, policarbonato y coberturas UPVC fabricados a medida en Perú. Cotiza por WhatsApp.',
} = Astro.props;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Mathen Perú',
  url: contacto.dominio,
  logo: `${contacto.dominio}/img/logo.png`,
  description:
    'Fabricación y comercialización de calaminas, planchas metálicas, paneles termoaislantes y coberturas para construcción e industria en Perú.',
  areaServed: 'PE',
  // Teléfono y correo solo entran al JSON-LD cuando son datos REALES del cliente.
  // Publicar placeholders aquí los haría indexables por Google como contacto oficial
  // de Mathen — el footer los muestra con aviso visible, los datos estructurados no pueden.
  ...(contacto.datosVerificados
    ? { telephone: contacto.telefono, email: contacto.correo }
    : {}),
};
import { asset } from '../lib/asset';
---

<!doctype html>
<html lang="es-PE">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href={asset('/img/logo.png')} />
    <link rel="canonical" href={contacto.dominio} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="es_PE" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!--
      Los bloques con `data-reveal` llegan VISIBLES en el HTML y era JavaScript quien los
      apagaba tras hidratar: el texto se pintaba, desaparecía y volvía a entrar animado.
      Esta marca se aplica ANTES del primer pintado, así que el bloque nunca llega a verse
      antes de su animación. Va inline y sin `type=module` para que no se difiera.
      El temporizador es la red de seguridad: si el JS de animación no llegara a
      ejecutarse, el texto aparece igual en lugar de quedarse invisible para siempre.
    -->
    <script is:inline>
      var raiz = document.documentElement;
      raiz.classList.add('reveal-armado');
      // Se desarma en cuanto la pagina termina de cargar, no a los 2.5s a ciegas: el
      // temporizador ciego GARANTIZABA hasta 2.5s de invisibilidad para cualquier seccion
      // cuyo script de revelado aun no hubiera corrido, aunque el usuario ya estuviera
      // mirandola. Quitar la clase no descubre nada indebido: GSAP escribe `visibility`
      // en linea al construir cada animacion, y el estilo en linea gana a esta regla.
      var desarmar = function () {
        raiz.classList.remove('reveal-armado');
      };
      if (document.readyState === 'complete') desarmar();
      else window.addEventListener('load', desarmar, { once: true });
      // Tope absoluto por si `load` no llegara nunca (una imagen que no resuelve).
      setTimeout(desarmar, 2500);
    </script>
    <noscript>
      <!-- Sin JavaScript no hay animacion que revele nada: el contenido debe verse. -->
      <style>
        [data-reveal] {
          visibility: visible !important;
        }
      </style>
    </noscript>
  </head>
  <body class="bg-ink-950 text-paper font-body antialiased">
    <slot />
  </body>
</html>
