---
/**
 * Escena 1/8 — `hero` (scroll global 0.00–0.12).
 * 3D: plancha Aluzinc plana en reposo, cámara acercándose (ver mapa-escenas).
 * H1 único de la página. Texto entregado por el cliente (17-09-2026):
 * "COBERTURAS A MEDIDA DE TU PROYECTO : calaminas pre pintadas en aluzinc y aluminio, termo
 *  techo y termo muro tipo sandwich, policarbonatos, placa colaborante, termoacustico UPVC,
 *  fabricados en Perú y entregas a nivel nacional."
 * Se respeta su redacción; solo se corrige ortografía (prepintadas, sándwich, termoacústico),
 * se escribe "Aluzinc" como en el resto del sitio, y el cierre pasa a frase aparte para que
 * no cuelgue de la enumeración. Las mayúsculas del original son énfasis suyo, no un estilo:
 * el H1 del sitio va en caja normal.
 */
import Button from '../components/ui/Button.astro';
import { contacto } from '../data/publico';
import { buildWhatsAppLink, WHATSAPP_GENERIC_MESSAGE } from '../components/ui/whatsapp';

const waHref = buildWhatsAppLink(contacto.whatsapp, WHATSAPP_GENERIC_MESSAGE);
---

<section id="hero" class="relative z-10 min-h-screen flex items-center justify-center bg-transparent px-6 py-32">
  <!-- Velo local para legibilidad sobre el metal renderizado -->
  <div class="pointer-events-none absolute inset-0 [mask-image:linear-gradient(to_bottom,transparent_0%,black_10%,black_90%,transparent_100%)] bg-[radial-gradient(ellipse_at_center,rgba(6,7,10,0.7)_0%,rgba(6,7,10,0.15)_55%,transparent_75%)]" aria-hidden="true"></div>

  <!-- Marco técnico: esquinas de plano de ingeniería, se dibujan solas (DrawSVGPlugin) -->
  <svg
    class="pointer-events-none absolute inset-6 md:inset-10 w-[calc(100%-3rem)] h-[calc(100%-3rem)] md:w-[calc(100%-5rem)] md:h-[calc(100%-5rem)] text-orange/40"
    viewBox="0 0 100 100"
    preserveAspectRatio="none"
    aria-hidden="true"
  >
    <path data-draw d="M0,10 L0,0 L10,0" vector-effect="non-scaling-stroke" fill="none" stroke="currentColor" stroke-width="1.5" />
    <path data-draw d="M90,0 L100,0 L100,10" vector-effect="non-scaling-stroke" fill="none" stroke="currentColor" stroke-width="1.5" />
    <path data-draw d="M0,90 L0,100 L10,100" vector-effect="non-scaling-stroke" fill="none" stroke="currentColor" stroke-width="1.5" />
    <path data-draw d="M90,100 L100,100 L100,90" vector-effect="non-scaling-stroke" fill="none" stroke="currentColor" stroke-width="1.5" />
  </svg>

  <div data-reveal-group class="relative max-w-5xl text-center flex flex-col items-center">
    <h1 data-reveal data-split="lines" class="on-canvas font-display font-bold text-display-xl leading-[0.95] tracking-[-0.02em] text-paper text-balance">
      Coberturas a medida de tu proyecto
    </h1>

    <p data-reveal class="mt-6 text-body-lg text-paper-dim max-w-2xl">
      Calaminas prepintadas en Aluzinc y aluminio, termo techo y termo muro tipo sándwich,
      policarbonatos, placa colaborante y termoacústico UPVC. Fabricados en Perú, con entregas
      a nivel nacional.
    </p>

    <div data-reveal class="mt-9 flex flex-col sm:flex-row items-center gap-4">
      <Button href={waHref} variant="primary" target="_blank" ariaLabel="Cotizar por WhatsApp">
        Cotizar por WhatsApp
      </Button>
      <Button href="#catalogo" variant="secondary">Ver catálogo completo</Button>
    </div>
  </div>

  <div
    data-reveal
    class="absolute bottom-10 inset-x-0 flex flex-col items-center gap-2 text-paper-faint"
    aria-hidden="true"
  >
    <span class="label-tec">Desliza para conocer el material</span>
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" class="motion-safe:animate-bounce">
      <path d="M12 4v16m0 0-6-6m6 6 6-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </div>
</section>

<script>
  import { revealIn } from '../components/ui/scrollReveal';
  import { drawLinesIn } from '../components/ui/techDraw';
  const root = document.getElementById('hero');
  revealIn(root);
  drawLinesIn(root);

  /*
   * Avisa cuando el titular ha terminado de entrar, para que la escena 3D se monte DESPUÉS
   * (ver SceneDiferida.tsx): arrancar WebGL bloquea el hilo principal y congelaba esta
   * animación a mitad de recorrido.
   *
   * Se mira el estado real de las líneas en vez de esperar una duración fija: así no hay un
   * número mágico que se quede desfasado si cambia la animación, y con movimiento reducido
   * —donde no hay animación y las líneas ya están opacas— avisa en el primer fotograma.
   */
  const avisar = () => window.dispatchEvent(new Event('hero:entrada-lista'));
  const titular = root?.querySelector('[data-reveal][data-split]');
  if (!titular) {
    avisar();
  } else {
    const comprobar = () => {
      const lineas = titular.querySelectorAll(':scope > div > div');
      const completo =
        lineas.length > 0 &&
        Array.from(lineas).every((l) => parseFloat(getComputedStyle(l).opacity) > 0.99);
      if (completo) avisar();
      else requestAnimationFrame(comprobar);
    };
    requestAnimationFrame(comprobar);
  }
</script>
